# Copy to .env (never commit .env). All scripts, the pipeline, and the web app read this file.

# --- Database -------------------------------------------------------------------------------
# Default: the zero-install PGlite dev server (`pnpm db:start`), listening on 54320.
# Docker alternative (`docker compose up -d`) uses the same URL with a password:
#   postgres://postgres:postgres@127.0.0.1:54320/postgres
# Production: a managed Postgres URL (Neon/Supabase). Use the pooled URL for the web app.
DATABASE_URL=postgres://postgres@127.0.0.1:54320/postgres

# Port for `pnpm db:start` (PGlite dev server).
PGLITE_PORT=54320

# --- Pipeline -------------------------------------------------------------------------------
# Where raw fetched snapshots are stored (content-addressed, gzip). Relative to repo root.
SNAPSHOT_DIR=data/snapshots
# Honest crawler identification. Set CRAWLER_CONTACT to a URL or email where site owners can reach you.
CRAWLER_USER_AGENT=hclubsBot/0.1
CRAWLER_CONTACT=
# Minimum delay between requests to the same host (ms). robots.txt Crawl-delay is honored if larger.
CRAWLER_MIN_INTERVAL_MS=2000
LOG_LEVEL=info

# --- LLM extraction (optional; enrichment works without it) ----------------------------------
# Enable with `pnpm ingest:enrich --llm` (or preview with --llm-dry-run). Credentials resolve the
# Anthropic SDK's standard way: ANTHROPIC_API_KEY, or an `ant auth login` profile.
# ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=low
# Hard cap on LLM spend per enrichment run (USD).
EXTRACTION_BUDGET_USD=1.00
# One-line club summaries (cheaper model than extraction; ADR 0029)
SUMMARY_MODEL=claude-sonnet-5-5
# LLM cap per automatic refresh run (scripts/refresh.sh)
REFRESH_LLM_BUDGET=1

# --- Web search (optional; `pnpm hci find-sites --search`) ------------------------------------
# Brave Search API key (https://brave.com/search/api/). Used only to find candidate club websites
# and social profiles; a site is accepted only after its fetched home page names the club (ADR 0023).
# BRAVE_SEARCH_API_KEY=

# --- Static site (baked in at build time) -------------------------------------------------
# Public origin, e.g. https://you.github.io (sitemap, metadata). scripts/publish-pages.sh sets it.
# NEXT_PUBLIC_SITE_URL=
# Sub-path the site is served under, e.g. /clubindex for https://you.github.io/clubindex/.
# NEXT_PUBLIC_BASE_PATH=
# Shown on /about, /about/bot and club pages for corrections, takedowns and crawler opt-out.
# Use a project address, not a personal one. Pages render a neutral fallback when unset.
# CONTACT_EMAIL=
# Optional form (e.g. Google Form) for corrections, used instead of the email link.
# NEXT_PUBLIC_CORRECTIONS_FORM_URL=
# Optional form (e.g. a Google Form) behind each club page's "Share what you know" button
# (recruiting term/deadline, how to join, comp stages, hours, size, dues, a source link).
# Placeholders, URL-encoded per link (ADR 0035): {clubref} = "Club Name [slug]", {club}, {slug},
# {type} = the form's "What kind of update?" option for the link's contribution type, and
# {details} = that type's answer template ("Dues (amount and how often, or none): "). Use a Google
# Form prefill link with your question ids, e.g.
# https://docs.google.com/forms/d/e/<id>/viewform?usp=pp_url&entry.<club>={clubref}&entry.<kind>={type}&entry.<details>={details}
# Falls back to a structured email to CONTACT_EMAIL when unset. https:// only.
# NEXT_PUBLIC_CONTRIBUTE_FORM_URL=
# Optional site-wide feedback form (footer "Feedback"); defaults to the contribute form without its prefill.
# Prefill the "What kind of update?" answer so it opens on site feedback, e.g.
# https://docs.google.com/forms/d/e/<id>/viewform?usp=pp_url&entry.<question id>=Feedback+about+the+site
NEXT_PUBLIC_FEEDBACK_FORM_URL=
# Optional page-view counts with GoatCounter (cookie-free, no personal data). Set to your
# GoatCounter site code, e.g. "hclubs" for https://hclubs.goatcounter.com. Unset = no analytics script.
# NEXT_PUBLIC_GOATCOUNTER_CODE=
# Optional form behind "Run this club? Update your page" (club officers). Same placeholders;
# falls back to an email to CONTACT_EMAIL asking for the club's official email or website.
# NEXT_PUBLIC_CLUB_MANAGER_FORM_URL=
