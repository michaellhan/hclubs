# Copy to .env (never commit .env). All scripts, the pipeline, and the web app read this file.

# --- Database -------------------------------------------------------------------------------
# Default: the zero-install PGlite dev server (`pnpm db:start`), listening on 54320.
# Docker alternative (`docker compose up -d`) uses the same URL with a password:
#   postgres://postgres:postgres@127.0.0.1:54320/postgres
# Production: a managed Postgres URL (Neon/Supabase). Use the pooled URL for the web app.
DATABASE_URL=postgres://postgres@127.0.0.1:54320/postgres

# Port for `pnpm db:start` (PGlite dev server).
PGLITE_PORT=54320

# --- Pipeline -------------------------------------------------------------------------------
# Where raw fetched snapshots are stored (content-addressed, gzip). Relative to repo root.
SNAPSHOT_DIR=data/snapshots
# Honest crawler identification. Set CRAWLER_CONTACT to a URL or email where site owners can reach you.
CRAWLER_USER_AGENT=ClubIndexBot/0.1
CRAWLER_CONTACT=
# Minimum delay between requests to the same host (ms). robots.txt Crawl-delay is honored if larger.
CRAWLER_MIN_INTERVAL_MS=2000
LOG_LEVEL=info

# --- LLM extraction (optional; enrichment works without it) ----------------------------------
# Enable with `pnpm ingest:enrich --llm` (or preview with --llm-dry-run). Credentials resolve the
# Anthropic SDK's standard way: ANTHROPIC_API_KEY, or an `ant auth login` profile.
# ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=low
# Hard cap on LLM spend per enrichment run (USD).
EXTRACTION_BUDGET_USD=1.00

# --- Web app (public site) -------------------------------------------------------------------
# Canonical origin, used for the sitemap, robots.txt and metadata.
# NEXT_PUBLIC_SITE_URL=https://example.com
# Shown on /about and /about/bot for corrections, takedowns and crawler opt-out. Use a
# project address, not a personal one. Pages render a neutral fallback when unset.
# CONTACT_EMAIL=
# Keyed hash for anonymous submission rate limiting. Required in production (any long random
# string, e.g. `openssl rand -hex 32`); dev falls back to a per-process random secret.
# SUBMISSION_HMAC_SECRET=
