{
  "name": "harvard-club-index",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @hci/web dev",
    "build": "pnpm --filter @hci/web build",
    "start": "pnpm --filter @hci/web start",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "pnpm --filter @hci/db db:start",
    "db:generate": "pnpm --filter @hci/db db:generate",
    "db:migrate": "pnpm --filter @hci/db db:migrate",
    "db:seed": "pnpm --filter @hci/db db:seed",
    "db:reset": "pnpm --filter @hci/db db:reset",
    "hci": "pnpm --filter @hci/pipeline --silent run cli",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ingest:discover": "pnpm hci discover",
    "ingest:find-sites": "pnpm hci find-sites",
    "ingest:enrich": "pnpm hci enrich",
    "ingest:reconcile": "pnpm hci reconcile",
    "ingest:export": "pnpm hci export",
    "ingest:stats": "pnpm hci stats",
    "ingest:all": "pnpm hci discover && pnpm hci find-sites && pnpm hci enrich && pnpm hci reconcile && pnpm hci stats"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.6",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
